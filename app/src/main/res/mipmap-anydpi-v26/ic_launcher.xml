<?xml version="1.0" encoding="utf-8"?>
<!-- Lo sfondo non e piu un colore piatto ma un disegno: il cielo del tema
     Spaziale, con le sue stelline. Il livello monochrome e quello che Android
     13 e oltre tinge con i colori del telefono quando il tema e a icone
     tinte: senza, il sistema si arrangia ritagliando il primo piano e la
     stella verrebbe una macchia. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
